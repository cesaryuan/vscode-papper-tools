{
  "name": "pandoc-manuscript-tools",
  "displayName": "Papper Tools",
  "description": "%extension.description%",
  "version": "0.8.2",
  "publisher": "cesaryuan",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesaryuan/vscode-pandoc-manuscript-tools.git"
  },
  "bugs": {
    "url": "https://github.com/cesaryuan/vscode-pandoc-manuscript-tools/issues"
  },
  "homepage": "https://github.com/cesaryuan/vscode-pandoc-manuscript-tools#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "icon": "assets/icon.png",
  "scripts": {
    "sync:papper-config": "tsx scripts/sync-papper-configuration.ts",
    "test:configuration-contract": "tsx --test tests/configurationContract.test.ts",
    "bundle": "tsx scripts/copy-mathjax-fonts.ts && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --minify --legal-comments=none && esbuild src/imageDirectoryPreview/webview.ts --bundle --platform=browser --format=iife --target=es2022 --outfile=dist/image-directory-preview.js --minify --legal-comments=none",
    "check:bundle": "node --check dist/extension.js && node --check dist/image-directory-preview.js",
    "package:vsix": "npm run check && vsce package",
    "publish:marketplace": "npm run check && vsce publish",
    "publish:patch": "npm run check && vsce publish patch",
    "publish:minor": "npm run check && vsce publish minor",
    "profile:test-md": "tsx scripts/profile-test-md.ts test.md",
    "test": "tsx --test tests/parser.test.ts tests/configurationContract.test.ts tests/elementAttributes.test.ts tests/markdownYamlHeader.test.ts tests/manuscriptStyle.test.ts tests/styleConfiguration.test.ts tests/reviewerReplyDefinitions.test.ts tests/inlineFoldParser.test.ts tests/headingStructure.test.ts tests/mathHoverParser.test.ts tests/metafilePreviewAppearance.test.ts tests/metafileResourceCache.test.ts tests/customImagePreviewContext.test.ts tests/pathResolver.test.ts tests/imageDirectoryPreview.test.ts tests/paragraphTranslationDiff.test.ts tests/commentParagraph.test.ts tests/pandocNumbering.test.ts tests/inlayReferences.test.ts tests/inlaySettings.test.ts tests/cslStyles.test.ts tests/papperSettings.test.ts tests/papperToolPolicy.test.ts tests/papperUpdateProgress.test.ts tests/papperHtmlServer.test.ts tests/papperMarkdownScrollIntent.test.ts tests/papperMarkdownClickNavigation.test.ts tests/papperMarkdownScrollAnchors.test.ts tests/papperMarkdownMathRendering.test.ts tests/papperMarkdownLifecycle.test.ts tests/htmlResourceUris.test.ts tests/paragraphTranslator.test.ts tests/workspaceIndex.test.ts tests/asyncLruCache.test.ts tests/imagePreviewCache.test.ts tests/localization.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run bundle && npm run check:bundle"
  },
  "activationEvents": [
    "onLanguage",
    "onCommand:pandocManuscriptTools.rebuildIndex",
    "onCommand:pandocManuscriptTools.buildDocxAndOpen",
    "onCommand:pandocManuscriptTools.buildHtmlAndOpen",
    "onCommand:pandocManuscriptTools.installOrUpdatePapper",
    "onCommand:pandocManuscriptTools.openImagePreviewToSide",
    "onCommand:pandocManuscriptTools.openImageDirectoryPreview",
    "onCustomEditor:pandocManuscriptTools.metafilePreviewEditor",
    "onCustomEditor:pandocManuscriptTools.svgPreviewEditor"
  ],
  "main": "./dist/extension.js",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist/extension.js",
    "dist/image-directory-preview.js",
    "assets/icon.png",
    "assets/style-project.yml",
    "assets/papper-configuration.json",
    "assets/libemf2svg/emf2svg.js",
    "assets/libemf2svg/emf2svg.wasm",
    "assets/mathjax-newcm-font/cjs/svg/dynamic/*.js",
    "package.nls.json",
    "package.nls.*.json",
    "l10n/**"
  ],
  "dependencies": {
    "@jimp/core": "^1.6.1",
    "@jimp/js-jpeg": "^1.6.1",
    "@jimp/js-png": "^1.6.1",
    "@jimp/plugin-resize": "^1.6.1",
    "@mathjax/src": "^4.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "pandocManuscriptTools.openSettings",
        "title": "%command.openSettings%"
      },
      {
        "command": "pandocManuscriptTools.setCitationStyle",
        "title": "%command.setCitationStyle%"
      },
      {
        "command": "pandocManuscriptTools.mergeStyleExample",
        "title": "%command.mergeStyleExample%"
      },
      {
        "command": "pandocManuscriptTools.rebuildIndex",
        "title": "%command.rebuildIndex%"
      },
      {
        "command": "pandocManuscriptTools.buildDocxAndOpen",
        "title": "%command.buildDocxAndOpen%",
        "icon": "$(play)"
      },
      {
        "command": "pandocManuscriptTools.buildHtmlAndOpen",
        "title": "%command.buildHtmlAndOpen%",
        "icon": "$(book)"
      },
      {
        "command": "pandocManuscriptTools.installOrUpdatePapper",
        "title": "%command.installOrUpdatePapper%"
      },
      {
        "command": "pandocManuscriptTools.openImagePreviewToSide",
        "title": "%command.openImagePreviewToSide%",
        "icon": "$(open-preview)"
      },
      {
        "command": "pandocManuscriptTools.openImageDirectoryPreview",
        "title": "%command.openImageDirectoryPreview%",
        "icon": "$(file-media)"
      },
      {
        "command": "pandocManuscriptTools.openSvgPreview",
        "title": "%command.openSvgPreview%",
        "icon": "$(eye)"
      },
      {
        "command": "pandocManuscriptTools.openSvgSourceText",
        "title": "%command.openSvgSourceText%",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pandocManuscriptTools.buildDocxAndOpen",
          "when": "resourceLangId == markdown && resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "pandocManuscriptTools.buildHtmlAndOpen",
          "when": "resourceLangId == markdown && resourceScheme == file && pandocManuscriptTools.canBuildHtml",
          "group": "navigation"
        },
        {
          "command": "pandocManuscriptTools.openImagePreviewToSide",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(svg|emf|wmf)$/i",
          "group": "navigation"
        },
        {
          "command": "pandocManuscriptTools.openSvgPreview",
          "when": "resourceExtname =~ /\\.svg$/i && !activeCustomEditorId",
          "group": "navigation"
        },
        {
          "command": "pandocManuscriptTools.openSvgSourceText",
          "when": "activeCustomEditorId == pandocManuscriptTools.svgPreviewEditor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "pandocManuscriptTools.openImageDirectoryPreview",
          "when": "explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ],
      "commandPalette": [
        {
          "command": "pandocManuscriptTools.mergeStyleExample",
          "when": "resourceScheme == file && resourceFilename =~ /^(style|style-project)\\.ya?ml$/"
        },
        {
          "command": "pandocManuscriptTools.buildDocxAndOpen",
          "when": "resourceLangId == markdown && resourceScheme == file"
        },
        {
          "command": "pandocManuscriptTools.buildHtmlAndOpen",
          "when": "resourceLangId == markdown && resourceScheme == file && pandocManuscriptTools.canBuildHtml"
        },
        {
          "command": "pandocManuscriptTools.installOrUpdatePapper"
        },
        {
          "command": "pandocManuscriptTools.openImagePreviewToSide",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(svg|emf|wmf)$/i"
        },
        {
          "command": "pandocManuscriptTools.openSvgPreview",
          "when": "resourceExtname =~ /\\.svg$/i && !activeCustomEditorId"
        },
        {
          "command": "pandocManuscriptTools.openSvgSourceText",
          "when": "activeCustomEditorId == pandocManuscriptTools.svgPreviewEditor"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "pandocManuscriptTools.metafilePreviewEditor",
        "displayName": "%editor.metafilePreviewEditor%",
        "selector": [
          {
            "filenamePattern": "*.emf"
          },
          {
            "filenamePattern": "*.wmf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "pandocManuscriptTools.svgPreviewEditor",
        "displayName": "%editor.svgPreviewEditor%",
        "selector": [
          {
            "filenamePattern": "*.svg"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Papper Tools",
      "properties": {
        "pandocManuscriptTools.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enableDiagnostics%"
        },
        "pandocManuscriptTools.enableNumberInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enableNumberInlayHints%"
        },
        "pandocManuscriptTools.includeWorkspaceReferences": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.includeWorkspaceReferences%"
        },
        "pandocManuscriptTools.includeLabelSymbols": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.includeLabelSymbols%"
        },
        "pandocManuscriptTools.highlightFencedDivs": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.highlightFencedDivs%"
        },
        "pandocManuscriptTools.highlightBracketedSpans": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.highlightBracketedSpans%"
        },
        "pandocManuscriptTools.foldLineExcerptCodeSpans": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.foldLineExcerptCodeSpans%"
        },
        "pandocManuscriptTools.foldRevisionCharSpanAttributes": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.foldRevisionCharSpanAttributes%"
        },
        "pandocManuscriptTools.enableInlineMathParagraphHover": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.enableInlineMathParagraphHover%"
        },
        "pandocManuscriptTools.inlineMathParagraphHoverMaxCharacters": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "%configuration.inlineMathParagraphHoverMaxCharacters%"
        },
        "pandocManuscriptTools.enableParagraphHoverTranslation": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enableParagraphHoverTranslation%"
        },
        "pandocManuscriptTools.debugParagraphHoverTranslation": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.debugParagraphHoverTranslation%"
        },
        "pandocManuscriptTools.enableDiffAwareParagraphHoverTranslation": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enableDiffAwareParagraphHoverTranslation%"
        },
        "pandocManuscriptTools.paragraphHoverTranslationMaxCharacters": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "%configuration.paragraphHoverTranslationMaxCharacters%"
        },
        "pandocManuscriptTools.paragraphHoverTranslationTargetLanguage": {
          "type": "string",
          "default": "zh",
          "description": "%configuration.paragraphHoverTranslationTargetLanguage%"
        },
        "pandocManuscriptTools.imageDirectoryPreviewScanDepth": {
          "type": "number",
          "scope": "resource",
          "default": -1,
          "minimum": -1,
          "description": "%configuration.imageDirectoryPreviewScanDepth%"
        },
        "pandocManuscriptTools.imageDirectoryPreviewIncludedFolderKeywords": {
          "type": "array",
          "scope": "resource",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%configuration.imageDirectoryPreviewIncludedFolderKeywords%"
        },
        "pandocManuscriptTools.imageDirectoryPreviewExcludedFolderKeywords": {
          "type": "array",
          "scope": "resource",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%configuration.imageDirectoryPreviewExcludedFolderKeywords%"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.1-rc"
  },
  "l10n": "./l10n"
}
